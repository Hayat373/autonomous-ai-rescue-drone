<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rescue_person">

    <static>true</static>

    <!-- BODY -->
    <link name="body">
      <pose>0 0 1.0 0 0 0</pose>

      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.45 0.30 1.0</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.45 0.30 1.0</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.2 0.8 1</diffuse>
        </material>
      </visual>
    </link>


    <!-- HEAD -->
    <link name="head">
      <pose>0 0 1.75 0 0 0</pose>

      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="head_collision">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="head_visual">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.8 0.6 0.4 1</ambient>
          <diffuse>0.8 0.6 0.4 1</diffuse>
        </material>
      </visual>
    </link>


    <!-- LEFT LEG -->
    <link name="left_leg">
      <pose>-0.12 0 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.15 0.18 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.15 0.18 0.5</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>


    <!-- RIGHT LEG -->
    <link name="right_leg">
      <pose>0.12 0 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.15 0.18 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.15 0.18 0.5</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
